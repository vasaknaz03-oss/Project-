{
  "name": "pc-podbor",
  "productName": "ПодборПК",
  "version": "1.7.0",
  "description": "Подбор комплектующих для ПК под бюджет по ценам Onliner и объявлениям Kufar",
  "podborServer": "",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "web": "node start-web.js",
    "test": "node test/run.js",
    "dist": "electron-builder --win portable nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "by.podbor.pc",
    "productName": "PodborPK",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "PodborPK-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "PodborPK-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ПодборПК"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDisplayName": "ПодборПК",
        "NSHumanReadableCopyright": "Цены: Onliner, Kufar. Курсы: НБРБ."
      }
    },
    "dmg": {
      "artifactName": "PodborPK-${version}-mac-${arch}.${ext}",
      "title": "ПодборПК",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0"
  }
}
