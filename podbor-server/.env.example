# Скопируйте в .env и заполните. Файл .env не коммитьте — в нём ключи.

# Домен сервера (DNS-запись A должна указывать на IP сервера), например api.podborpk.by
DOMAIN=api.example.com

# Пароль для админ-статистики (длинная случайная строка): GET /v1/admin/stats с заголовком X-Admin-Token
ADMIN_TOKEN=

# Ключ Anthropic (ИИ-помощник). Пусто — ИИ на сервере выключен.
ANTHROPIC_API_KEY=
# Общий дневной бюджет на ИИ, $ (когда исчерпан — ИИ до полуночи UTC отклоняется)
AI_DAILY_BUDGET_USD=5

# Бесплатная замена Anthropic: своя модель. Вариант 1 — Ollama на этом же сервере:
#   docker compose --profile ollama up -d   и   docker compose exec ollama ollama pull qwen3:4b
#   AI_BASE_URL=http://ollama:11434   AI_MODEL=qwen3:4b   AI_KIND=ollama
# Вариант 2 — любой OpenAI-совместимый сервис: AI_BASE_URL=https://…  AI_MODEL=…  AI_API_KEY=…  AI_KIND=openai
# Если задан ANTHROPIC_API_KEY, он главнее. Своя модель бюджет не тратит.
AI_BASE_URL=
AI_MODEL=
AI_KIND=
AI_API_KEY=
# Для платного сервиса — его цены за 1 млн токенов ($): тогда расходы считаются и AI_DAILY_BUDGET_USD соблюдается.
# Для своей Ollama оставьте 0.
AI_PRICE_INPUT_PER_M=0
AI_PRICE_OUTPUT_PER_M=0

# Ключ YouTube Data API v3. Пусто — видео выключены.
YOUTUBE_API_KEY=

# Токен общего Telegram-бота (создать у @BotFather). Пусто — уведомления через сервер выключены.
TELEGRAM_BOT_TOKEN=

# Суточные лимиты на одно устройство (бесплатный тариф)
LIMIT_FREE_RESEARCH=5
LIMIT_FREE_RESEARCH_DEEP=1
LIMIT_FREE_REVIEWS=20
LIMIT_FREE_YOUTUBE=40
LIMIT_FREE_KUFAR_SCANS=40
LIMIT_FREE_FETCH=5000
LIMIT_FREE_NOTIFY=100

# Цены для учёта расходов ИИ (сверяйте с anthropic.com/pricing)
PRICE_INPUT_PER_M=4
PRICE_OUTPUT_PER_M=20
PRICE_WEB_SEARCH_PER_1K=10
